LOCAL_SERVICE_TOKEN=sostituisci-con-almeno-32-caratteri-casuali
LOCAL_SERVICE_HOST=127.0.0.1
LOCAL_SERVICE_PORT=4100
LOCAL_SERVICE_DATA_DIR=.local-service

# file = scrive i ticket in .local-service/spool; network = invia a una stampante ESC/POS.
PRINTER_MODE=file
# PRINTER_HOST=192.168.1.50
# PRINTER_PORT=9100

# test mode scrive gli eventi di sincronizzazione nella spool locale.
LOCAL_SERVICE_TEST_MODE=true
# CLOUD_SYNC_URL=https://example.invalid/api/local-service/events
# CLOUD_SYNC_TOKEN=sostituisci-con-token-cloud

LOCAL_SERVICE_WORKER_DISABLED=false
LOCAL_SERVICE_POLL_MS=2000
LOCAL_SERVICE_BATCH_SIZE=10
