# Copia questo file in .env.local e sostituisci i segnaposto.
# Per lo sviluppo locale usa i valori mostrati da `npx supabase status`.
# Non committare mai .env.local né chiavi reali.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55001
NEXT_PUBLIC_SUPABASE_ANON_KEY=sostituisci-con-anon-key-locale
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo per i test e2e in locale (pulizia automatica dei dati di prova).
# Valore da `npx supabase status`. Mai esporre al client o usare in produzione.
# SUPABASE_SERVICE_ROLE_KEY=sostituisci-con-service-role-key-locale

# API interne receptionist (solo server). Genera valori casuali di almeno 32 caratteri.
# RECEPTIONIST_INTERNAL_TOKEN=sostituisci-con-token-bootstrap
# RECEPTIONIST_INTERNAL_SECRET=sostituisci-con-segreto-hmac

# Servizio locale (processo separato): configurazione in local-service/.env.example.
